# Keep the build context small and the image clean.
.venv/
**/__pycache__/
*.pyc
.git/
.gitignore
logs/
# Local runtime output — the container generates its own under the reports volume.
reports/*.md
reports/.candidates_snap.json
reports/.edgar_cik.json
reports/*.lock
reports/*.tmp
# Local one-shot / macOS scheduling artefacts (replaced by the compose scheduler).
oneshot_fullscreen.sh
launchd/
scratchpad/
*.md.bak
