# Copy to .env and fill in what you want. Everything here is OPTIONAL — the app
# runs on SEC EDGAR + Yahoo with no keys at all; each key just lights up more.

# SEC fair-access asks for a descriptive User-Agent with a contact. Recommended.
SEC_EDGAR_UA="Your Name your@email.com"

# SimFin (optional): fundamentals for foreign filers EDGAR can't cover (20-F/40-F),
# and the SimFin-vs-Yahoo data cross-check. Free key at simfin.com.
# SIMFIN_API_KEY=

# Anthropic (optional): enables the AI qualitative read (moat/management/risks).
# Costs per analysis. Key at console.anthropic.com.
# ANTHROPIC_API_KEY=

# Host port to expose the web UI on (container always listens on 8000 internally).
# APP_PORT=8000

# Timezone for the optional weekly scheduler (e.g. America/New_York).
# TZ=UTC

# Weekly scheduler knobs (only used with `--profile scheduler`):
# SCREEN_SCOPE=large        # core (~57) | full (~207) | large (~900) | all (~2000, slow)
# SCHEDULE_HOUR=8           # local hour to run
# SCHEDULE_WEEKDAY=0        # 0=Mon … 6=Sun
