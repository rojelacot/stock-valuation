# Copy to .env and fill in to enable Claude's qualitative analysis.
# Without this, the app still runs — it just shows the quantitative model only.
ANTHROPIC_API_KEY=

# Optional: SimFin API key for cleaner fundamentals on the single-stock Analyze
# view (free tier = 5yr history + 500 credits/mo; $15/mo = 10yr+). Falls back to
# Yahoo automatically. The bulk screener always uses Yahoo to conserve credits.
SIMFIN_API_KEY=
